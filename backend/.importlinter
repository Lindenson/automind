[importlinter]
root_package = automind
include_external_packages = True

[importlinter:contract:domain-pure]
name = Domain is pure (constitution V)
type = forbidden
source_modules =
    automind.chat.domain
    automind.shared.vehicle.identity
    automind.shared.vehicle.specs
    automind.shared.vehicle.units
    automind.shared.evidence
    automind.shared.research_order
    automind.acquisition.domain.plausibility
    automind.acquisition.domain.sense_ev
    automind.acquisition.domain.relevance
    automind.observability.domain.outcome
forbidden_modules =
    langgraph
    langchain
    langchain_core
    langchain_openai
    langchain_anthropic
    langchain_mcp_adapters
    fastapi
    sqlalchemy
    httpx
    tavily
    mcp
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.shared.infrastructure
    automind.chat.infrastructure
    automind.acquisition.infrastructure.search
    automind.acquisition.infrastructure.retention
    automind.acquisition.infrastructure.overrides
    automind.observability.infrastructure.outcomes
    automind.delivery.web

[importlinter:contract:application-ports]
name = Application depends only on domain and ports
type = forbidden
source_modules =
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.acquisition.reputation.application
forbidden_modules =
    automind.chat.dialog
    automind.delivery.web
    automind.shared.infrastructure
    automind.chat.infrastructure
    automind.acquisition.infrastructure.search
    automind.acquisition.infrastructure.retention
    automind.acquisition.infrastructure.overrides
    automind.observability.infrastructure.outcomes
    langgraph
    fastapi
    sqlalchemy
# Legacy demo services still use the DB directly. New application code goes through ports
# (chat/application/ports.py). Remove these lines as each module is moved behind a port.
ignore_imports =
    # one-off data repair after the 004 verification fixes; uses the research persistence directly
    automind.chat.application.maintenance.repair -> automind.shared.infrastructure.**
    automind.chat.application.maintenance.repair -> sqlalchemy
    automind.chat.application.usecases.challenge -> automind.shared.infrastructure.**
    automind.chat.application.usecases.challenge -> sqlalchemy

# --- spec 010 -------------------------------------------------------------------------------------
[importlinter:contract:insight-domain-pure]
name = Insight domain is pure (spec 010, constitution V)
type = forbidden
source_modules =
    automind.observability.domain
forbidden_modules =
    langgraph
    langchain
    langchain_core
    fastapi
    sqlalchemy
    httpx
    prometheus_client
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.shared.infrastructure
    automind.chat.infrastructure
    automind.acquisition.infrastructure.search
    automind.acquisition.infrastructure.retention
    automind.acquisition.infrastructure.overrides
    automind.observability.infrastructure.outcomes
    automind.delivery.web
    automind.observability.application
    automind.observability.infrastructure
    automind.observability.metrics

[importlinter:contract:registry-domain-pure]
name = Registry domain is pure (spec 010)
type = forbidden
source_modules =
    automind.acquisition.registry.domain
forbidden_modules =
    langgraph
    langchain
    langchain_core
    fastapi
    sqlalchemy
    httpx
    prometheus_client
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.shared.infrastructure
    automind.chat.infrastructure
    automind.acquisition.infrastructure.search
    automind.acquisition.infrastructure.retention
    automind.acquisition.infrastructure.overrides
    automind.observability.infrastructure.outcomes
    automind.delivery.web
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure

[importlinter:contract:registry-boundary]
name = The chat cycle uses the registry only through acquisition.registry.api (spec 010)
type = forbidden
source_modules =
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.chat.domain
    automind.shared.vehicle.identity
    automind.shared.vehicle.specs
    automind.shared.vehicle.units
    automind.shared.evidence
    automind.shared.research_order
    automind.acquisition.domain.plausibility
    automind.acquisition.domain.sense_ev
    automind.acquisition.domain.relevance
    automind.observability.domain.outcome
forbidden_modules =
    automind.acquisition.registry.domain
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure
allow_indirect_imports = True

[importlinter:contract:registry-no-chat]
name = The registry knows nothing about chats (spec 010)
type = forbidden
source_modules =
    automind.acquisition
forbidden_modules =
    automind.chat.dialog
    automind.delivery.web
    automind.chat.domain.case.casefile
    automind.observability.domain
    automind.observability.application
    automind.observability.infrastructure
# direct imports only: the shared infrastructure (config loader, adapters) reaches everything
allow_indirect_imports = True

[importlinter:contract:insight-independent]
name = Insight does not depend on the chat graph or registry internals (spec 010)
type = forbidden
source_modules =
    automind.observability
forbidden_modules =
    automind.chat.dialog
    automind.delivery.web
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure
allow_indirect_imports = True

# --- spec 011 -------------------------------------------------------------------------------------
[importlinter:contract:acquisition-domain-pure]
name = Acquisition engine pure cores (spec 011, constitution V, IX)
type = forbidden
source_modules =
    automind.acquisition.domain
    automind.acquisition.reputation.domain
    automind.acquisition.gold.domain
    automind.acquisition.snapshots.codec
    automind.acquisition.parsing.spec
    automind.acquisition.parsing.interpreter
    automind.acquisition.parsing.fingerprint
forbidden_modules =
    langgraph
    langchain
    langchain_core
    langchain_openai
    langchain_anthropic
    langchain_mcp_adapters
    fastapi
    sqlalchemy
    httpx
    prometheus_client
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.shared.infrastructure
    automind.chat.infrastructure
    automind.acquisition.infrastructure.search
    automind.acquisition.infrastructure.retention
    automind.acquisition.infrastructure.overrides
    automind.observability.infrastructure.outcomes
    automind.delivery.web

[importlinter:contract:chat-uses-acquire-only]
name = The chat orders data only through acquisition.api (spec 011 FR-005, FR-006, constitution XIII)
type = forbidden
source_modules =
    automind.chat.application
    automind.shared.metering
    automind.shared.vehicle.makes
    automind.chat.dialog
    automind.chat.domain
    automind.shared.vehicle.identity
    automind.shared.vehicle.specs
    automind.shared.vehicle.units
    automind.shared.evidence
    automind.shared.research_order
    automind.acquisition.domain.plausibility
    automind.acquisition.domain.sense_ev
    automind.acquisition.domain.relevance
    automind.observability.domain.outcome
forbidden_modules =
    automind.acquisition.infrastructure.search
    automind.acquisition.agents
    automind.acquisition.domain
    automind.acquisition.drift
    automind.acquisition.engine
    automind.acquisition.facade
    automind.acquisition.gates
    automind.acquisition.gold
    automind.acquisition.infrastructure
    automind.acquisition.parsing
    automind.acquisition.pipeline
    automind.acquisition.ports
    automind.acquisition.read
    automind.acquisition.recheck
    automind.acquisition.replay
    automind.acquisition.reputation
    automind.acquisition.snapshots
    automind.acquisition.worker
# direct imports, no ignore_imports: acquisition.api loads the engine at call time; the remaining legacy
# application -> shared.infrastructure edges (application-ports exceptions) would otherwise reach the engine indirectly
allow_indirect_imports = True

[importlinter:contract:api-uses-engine-facades]
name = The web API reaches the acquisition engine only through its facades (spec 011 T113)
type = forbidden
source_modules =
    automind.delivery.web
# allowed: automind.acquisition.api (the chat's order), automind.acquisition.admin_api (the admin page) and the 010
# registry modules the API already uses: registry.api (ws), registry.application.seed (app), registry.domain.model
# and registry.domain.seed_rules (admin)
forbidden_modules =
    automind.acquisition.agents
    automind.acquisition.domain
    automind.acquisition.drift
    automind.acquisition.engine
    automind.acquisition.facade
    automind.acquisition.gates
    automind.acquisition.gold
    automind.acquisition.infrastructure
    automind.acquisition.parsing
    automind.acquisition.pipeline
    automind.acquisition.ports
    automind.acquisition.read
    automind.acquisition.recheck
    automind.acquisition.replay
    automind.acquisition.reputation
    automind.acquisition.snapshots
    automind.acquisition.worker
    automind.acquisition.registry.application.admission
    automind.acquisition.registry.application.review
    automind.acquisition.registry.application.service
    automind.acquisition.registry.domain.admission
    automind.acquisition.registry.domain.blame
    automind.acquisition.registry.domain.families
    automind.acquisition.registry.domain.lifecycle
    automind.acquisition.registry.domain.limits
    automind.acquisition.registry.domain.score
    automind.acquisition.registry.infrastructure
# the composition root starts the search/page cache retention loop (it was infrastructure/retention.py before
# spec 012 moved it into the engine); the loop moves to the worker in S12, then this line goes
ignore_imports =
    automind.delivery.web.app -> automind.acquisition.infrastructure.retention
# direct imports, no ignore_imports: the facades themselves reach the engine
allow_indirect_imports = True

# --- spec 012 -------------------------------------------------------------------------------------
[importlinter:contract:shared-is-kernel]
name = The shared kernel depends on no area (spec 012 FR-013, constitution V)
type = forbidden
source_modules =
    automind.shared
forbidden_modules =
    automind.chat
    automind.acquisition
    automind.observability
    automind.delivery
