[importlinter]
root_package = automind
include_external_packages = True

[importlinter:contract:domain-pure]
name = Domain is pure (constitution V)
type = forbidden
source_modules =
    automind.domain
forbidden_modules =
    langgraph
    langchain
    langchain_core
    langchain_openai
    langchain_anthropic
    langchain_mcp_adapters
    fastapi
    sqlalchemy
    httpx
    tavily
    mcp
    automind.application
    automind.orchestration
    automind.infrastructure
    automind.api

[importlinter:contract:application-ports]
name = Application depends only on domain and ports
type = forbidden
source_modules =
    automind.application
forbidden_modules =
    automind.orchestration
    automind.api
    automind.infrastructure
    langgraph
    fastapi
    sqlalchemy
# Legacy demo services still use the DB directly. New application code goes through ports
# (application/ports.py). Remove these lines as each module is moved behind a port.
ignore_imports =
    automind.application.compose -> automind.infrastructure.**
    automind.application.compose -> sqlalchemy
    automind.application.research -> automind.infrastructure.**
    automind.application.research -> sqlalchemy
    automind.application.resolve -> automind.infrastructure.**
    automind.application.resolve -> sqlalchemy
    # one-off data repair after the 004 verification fixes; uses the research persistence directly
    automind.application.repair -> automind.infrastructure.**
    automind.application.repair -> sqlalchemy
    automind.application.challenge -> automind.infrastructure.**
    automind.application.challenge -> sqlalchemy
    # spec 005: the engine back-fill (one-off) uses the persistence directly, like repair
    automind.application.backfill -> automind.infrastructure.**
    automind.application.backfill -> sqlalchemy
    # spec 005: the brand line-up cache (brand_lineups), like resolve
    automind.application.lineup -> automind.infrastructure.**
    automind.application.lineup -> sqlalchemy

# --- spec 010 -------------------------------------------------------------------------------------
[importlinter:contract:insight-domain-pure]
name = Insight domain is pure (spec 010, constitution V)
type = forbidden
source_modules =
    automind.insight.domain
forbidden_modules =
    langgraph
    langchain
    langchain_core
    fastapi
    sqlalchemy
    httpx
    prometheus_client
    automind.application
    automind.orchestration
    automind.infrastructure
    automind.api
    automind.insight.application
    automind.insight.infrastructure
    automind.insight.metrics

[importlinter:contract:registry-domain-pure]
name = Registry domain is pure (spec 010)
type = forbidden
source_modules =
    automind.acquisition.registry.domain
forbidden_modules =
    langgraph
    langchain
    langchain_core
    fastapi
    sqlalchemy
    httpx
    prometheus_client
    automind.application
    automind.orchestration
    automind.infrastructure
    automind.api
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure

[importlinter:contract:registry-boundary]
name = The chat cycle uses the registry only through acquisition.registry.api (spec 010)
type = forbidden
source_modules =
    automind.application
    automind.orchestration
    automind.domain
forbidden_modules =
    automind.acquisition.registry.domain
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure
allow_indirect_imports = True

[importlinter:contract:registry-no-chat]
name = The registry knows nothing about chats (spec 010)
type = forbidden
source_modules =
    automind.acquisition
forbidden_modules =
    automind.orchestration
    automind.api
    automind.domain.casefile
    automind.insight.domain
    automind.insight.application
    automind.insight.infrastructure
# direct imports only: the shared infrastructure (config loader, adapters) reaches everything
allow_indirect_imports = True

[importlinter:contract:insight-independent]
name = Insight does not depend on the chat graph or registry internals (spec 010)
type = forbidden
source_modules =
    automind.insight
forbidden_modules =
    automind.orchestration
    automind.api
    automind.acquisition.registry.application
    automind.acquisition.registry.infrastructure
allow_indirect_imports = True
