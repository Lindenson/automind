# AutoMind — copy to .env and fill in. Never commit .env.
# Gemini (the default models in backend/config/models.yaml); GEMINI_API_KEY is accepted too
GOOGLE_API_KEY=
# Only needed when models.yaml or a MODEL_<ROLE>=provider:model override uses these providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Web search (config/search.yaml picks the provider; Serper = serper.dev, SerpApi = serpapi.com)
SERPER_API_KEY=
# SERPAPI_API_KEY=
# SEARCH_PROVIDER=serper

# Models per role live in backend/config/models.yaml; override one with MODEL_<ROLE>=provider:model

# scripts/deploy.sh generates POSTGRES_PASSWORD, ADMIN_TOKEN and METRICS_TOKEN into .env.docker (not here)

# Local dev DB (embedded Postgres in ./.pgdata). With Docker use:
# DATABASE_URL=postgresql+asyncpg://automind:automind@localhost:5432/automind
# DATABASE_URL=

MAX_LLM_CALLS_PER_TURN=160
FRESH_SPECS_DAYS=365
FRESH_PRICE_DAYS=30
FRESH_MAINTENANCE_DAYS=365

# API bind address (scripts/dev.sh): 127.0.0.1 = this machine only, 0.0.0.0 = local network (no login yet!)
# API_HOST=0.0.0.0
# API_PORT=8000
